#!/usr/bin/env node

/**
 * Module dependencies.
 */

const config = require('config');
const app = require('../app');
const debug = require('debug')('stride-co:server');
const http = require('http');// esta herramienta ya viene en Node.js
const { sequelize }=require ('../models/relationals');
const ensureConstraints = require('../database/ensure-constraints');
const connectMongo = require('../config/mongoose');

/**
 * Validar que el secreto de JWT exista antes de arrancar.
 * Sin esto, cualquier petición autenticada fallaría de forma confusa en tiempo
 * de ejecución; preferimos que el servidor no arranque y avise claramente.
 */
if (!config.has('jwt.secret') || !config.get('jwt.secret')) {
  console.error(
    'No se pudo iniciar el servidor: falta "jwt.secret" en la configuración.\n' +
    'Crea config/local-development.json (copiando config/local-development.example.json) ' +
    'y define jwt.secret con un valor propio.'
  );
  process.exit(1);
}

/**
 * Get port from config (lee server.port; en producción, Render lo sobreescribe
 * automáticamente vía la variable de entorno PORT, mapeada en
 * config/custom-environment-variables.json).
 */

var port = normalizePort(config.get('server.port'));
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

async function start(){
  await sequelize.authenticate();
  await sequelize.sync();
  await ensureConstraints();
  debug('conexion a mysql generada correctamente.');

  await connectMongo();
  debug('Conexion a mongodb correcta');
  server.listen(port);
}

/**
 * Listen on provided port, on all network interfaces.
 */

start();
server.on('error', onError);//onError, funcion definida mas abajo 
server.on('listening', onListening);//cuando ya este escuchando ejecuta onListening, definida abajo

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);//aqui la variable port es local no igual a la de arriba

  if (isNaN(port)) {//la conversion fallo, NaN not a number
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {//error es el objeto que creo server
  if (error.syscall !== 'listen') {//error.syscall el tipo de error,¿el error ocurrio en una
    throw error; //operacion distinta a listen si es asi lanza el error para que se propague
  }
//si el error sucedio al intentar escuchar conexiones seguimo con las sig lineas
  var bind = typeof port === 'string'//si port es string o si no es; bind = 
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');// parecido a console.log pero para errores stderr
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);// si debug esta encendido cuando el servidor este escuchando saldra un mensanje 
  //stride-co:server Listenins on port 3000 o algo parecido
}
