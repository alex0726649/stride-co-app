//- Layout del panel administrativo. Mismos bloques que el de la tienda
//- (title, description, content) más `heading` para el título visible.
//- El menú solo muestra las secciones implementadas y, cuando existe `can`
//- (lo agrega la sesión web de S3-04), solo las que el rol puede ver.
//- Ocultar un enlace no sustituye a authorize en la ruta.
- const canSee = (resource, action) => !locals.can || can(resource, action, 'any')
- const adminLinks = [{ href: '/admin/products', icon: 'box-seam', label: 'admin.nav.products', resource: 'products', action: 'update' }, { href: '/admin/inventory', icon: 'stack', label: 'admin.nav.inventory', resource: 'inventory', action: 'read' }]
doctype html
html(lang=locale)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title
      block title
        = (title ? title + ' · ' : '') + __('admin.panel')
    block description
      meta(name='description' content=description || __('admin.description'))
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet' href='/css/stride.css')
  body
    aside.admin-sidebar
      a.brand.d-block.px-3.mb-3(href='/admin') STRIDE#[span -CO]
      .sidebar-label.text-uppercase.tiny.px-3.mb-3= __('admin.panel')
      nav.nav.flex-column(aria-label=__('admin.panel'))
        each link in adminLinks
          if canSee(link.resource, link.action)
            a.nav-link(href=link.href class=currentPath.startsWith(link.href) ? 'active' : '' aria-current=currentPath.startsWith(link.href) ? 'page' : false)
              i.bi.me-2(class='bi-' + link.icon)
              | #{__(link.label)}
      .mt-4.px-2
        a.btn.btn-outline-light.w-100.btn-sm(href='/')
          i.bi.bi-shop.me-1
          | #{__('admin.viewStore')}
    main.admin-main
      .admin-top
        div
          .tiny= __('admin.breadcrumb')
          h1.h2.fw-bold.mb-0
            block heading
              = title || __('admin.panel')
        .d-flex.align-items-center.gap-2.flex-wrap
          include ../partials/lang-switch
          if locals.currentUser
            span.pill
              i.bi.bi-person-circle.me-1
              | #{currentUser.name || currentUser.email}
            form.d-inline(method='post' action='/logout')
              button.btn.btn-outline-secondary.btn-sm(type='submit')
                | #{__('nav.logout')}
                i.bi.bi-box-arrow-right.ms-1
      include ../partials/flash
      block content
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src='/js/stride.js')
