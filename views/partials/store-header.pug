//- Encabezado de la tienda (viene de views/includes/header.pug de la clase).
//- Textos traducidos, enlaces reales o "Próximamente" y el .container con su contenido.
- const storeLinks = [{ href: '/', label: 'nav.home' }, { href: '/products', label: 'nav.products' }, { href: '/my/orders', label: 'nav.orders' }]
- const isActive = href => href === '/' ? currentPath === '/' : currentPath.startsWith(href)
header.store-header
  .container.py-2.d-flex.justify-content-between.align-items-center.gap-3
    a.brand(href='/')
      | STRIDE#[span -CO]
      small.d-block.text-secondary= __('site.tagline')
    nav.store-nav.d-flex.align-items-center(aria-label=__('nav.label'))
      each link in storeLinks
        a(href=link.href class=isActive(link.href) ? 'active' : '' aria-current=isActive(link.href) ? 'page' : false)= __(link.label)
      a(href='/cart' class=isActive('/cart') ? 'active' : '' aria-current=isActive('/cart') ? 'page' : false)
        i.bi.bi-bag.me-1
        | #{__('nav.cart')}
    .d-flex.align-items-center.gap-2
      include lang-switch
      if locals.currentUser
        form.d-inline(method='post' action='/logout')
          button.btn.btn-outline-dark.btn-sm(type='submit')
            i.bi.bi-box-arrow-right.me-1
            | #{__('nav.logout')}
      a.btn.btn-outline-dark.btn-sm(href='/admin')
        i.bi.bi-shield-lock.me-1
        | #{__('nav.admin')}
